{
  "name": "videos-3d-zica",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "render": "node scripts/render.mjs",
    "previa": "node scripts/render.mjs --scale 0.5",
    "animatic": "node scripts/render.mjs --scale 0.5 --step 15",
    "look": "node scripts/look.mjs",
    "voz": "node scripts/voz.mjs",
    "roteiro": "node scripts/roteiro.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
