        "loop": true,
        "volume": 0.35
      },
      "burburinho-sala": {
        "prompt": "classroom of teenagers murmuring quietly, indoor, no clear words",
        "duration": 10,
        "loop": true,
        "volume": 0.3
      },
      "corredor-passos": {
        "prompt": "many students walking in a school corridor, sneakers on tile floor, worried murmuring, no clear words",
        "duration": 10,
        "loop": true,
        "volume": 0.35
      },
      "porao-ambiente": {
